---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import FeatureSection from '../components/FeatureSection.astro';
import StatsSection from '../components/StatsSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import ContactSection from '../components/ContactSection.astro';
import CTABanner from '../components/CTABanner.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';

const heroTabs = [
  {
    id: 'animals',
    eyebrow: 'Animal Management',
    headline: 'Manage every animal from intake to adoption in one place',
    description: 'Track profiles, medical history, and status changes in one dashboard — updates go live on your public site instantly.',
    imageSrc: '/images/home-hero-header-section-0.jpg',
    imageAlt: 'Animal management dashboard',
  },
  {
    id: 'marketing',
    eyebrow: 'Marketing Tools',
    headline: 'Auto-post available animals to social media and Petfinder',
    description: 'Generate AI-written captions and share to Facebook and Instagram in one click, with automatic Petfinder sync.',
    imageSrc: '/images/home-hero-header-section-1.jpg',
    imageAlt: 'Social media auto-posting',
  },
  {
    id: 'adoption',
    eyebrow: 'Adoption Tracking',
    headline: 'Review applications and track every adoption seamlessly',
    description: 'Receive adoption, foster, and volunteer applications online and move them through your pipeline with a full audit trail.',
    imageSrc: '/images/home-hero-header-section-2.jpg',
    imageAlt: 'Adoption application tracking',
  },
  {
    id: 'website',
    eyebrow: 'Website Builder',
    headline: 'Launch a beautiful rescue website in minutes',
    description: 'Edit content, upload photos, and change colors — no code and no developer needed to keep your site current.',
    imageSrc: '/images/home-hero-header-section-3.jpg',
    imageAlt: 'Rescue website builder',
  },
];

const coreFeatures = [
  { icon: '🐾', title: 'Animal Management', description: 'Complete profiles, medical history, and photos for every animal.' },
  { icon: '📋', title: 'Adoption Applications', description: 'Online applications with status tracking and admin notes.' },
  { icon: '🌐', title: 'Website Builder', description: 'A branded public site that updates the moment you do.' },
  { icon: '📣', title: 'Social Media AI', description: 'AI-generated captions ready to post in one click.' },
  { icon: '🤝', title: 'Volunteer Tools', description: 'Recruit, schedule, and manage your volunteer network.' },
  { icon: '💰', title: 'Donation Tracking', description: 'Log donations, issue receipts, and track fundraising progress.' },
];
---

<BaseLayout title="Rescue Tech Simplified" description="The all-in-one platform for animal rescues — animal management, adoption tracking, marketing, and a beautiful website, all in one place.">
  <Navbar currentPage="/" />

  <!-- Hero: animated tabs -->
  <Hero tabs={heroTabs} />

  <!-- Benefits -->
  <BenefitsSection
    scheme={8}
    eyebrow="Why Rescues Choose Barkhaus"
    heading="Everything your rescue needs, nothing it doesn't"
    benefits={[
      { icon: '🧩', title: 'Replace 8 tools with 1 platform', description: 'Stop juggling separate tools for your website, applications, and social media.' },
      { icon: '⚡', title: 'Go live in under an hour', description: 'Set up your org, add your animals, and publish your site the same day.' },
      { icon: '🐕', title: 'Built for rescues, not developers', description: 'No code, no IT team — just the tools rescues actually need.' },
    ]}
  />

  <!-- Feature: Animal Management -->
  <FeatureSection
    scheme={1}
    eyebrow="Animal Management"
    heading="Every animal. Every detail. In one place."
    body="Add animals, track health records, manage photos, and update status from intake to adopted — all synced live to your public site."
    imageSrc="/images/home-feature-section-0.jpg"
    imageAlt="Animal management"
    ctaLabel="Explore animal management"
    ctaHref="/features/animals"
  />

  <!-- Feature: Marketing Tools -->
  <FeatureSection
    scheme={8}
    eyebrow="Marketing Tools"
    heading="Post to social media in seconds"
    body="AI-generated posts, one-click sharing to Facebook and Instagram, and auto-sync to Petfinder — no more manual copywriting."
    imageSrc="/images/home-feature-section-1.jpg"
    imageAlt="Social media marketing tools"
    reverse
    ctaLabel="See social media AI"
    ctaHref="/features/social-media"
  />

  <!-- Feature: Website Builder -->
  <FeatureSection
    scheme={1}
    eyebrow="Website Builder"
    heading="Your rescue website, ready in minutes"
    body="Edit content, upload photos, and change colors — no code, no developer needed to keep your public site current."
    imageSrc="/images/home-feature-section-2.jpg"
    imageAlt="Website builder"
    ctaLabel="See website builder"
    ctaHref="/features/public-website"
  />

  <!-- Features list -->
  <section class="scheme-8 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl sm:text-4xl font-medium">Everything you need to run your rescue</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreFeatures.map((f) => (
          <FeatureCard {...f} />
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits with stats -->
  <StatsSection
    scheme={1}
    eyebrow="Real Results"
    heading="Rescues using Barkhaus see results"
    imageSrc="/images/home-benefits-section-1.png"
    imageAlt="Rescue results"
    stats={[
      { value: '3x', label: 'Faster adoption processing' },
      { value: '60%', label: 'Less admin time' },
      { value: '2x', label: 'More website traffic' },
    ]}
  />

  <!-- CTA: See it in action -->
  <CTABanner
    headline="See Barkhaus in Action"
    subtext="Get early access today — join the rescues already saving time and finding more homes."
    primaryCta={{ label: 'Start Free', href: '/signup' }}
  />

  <!-- Testimonials -->
  <TestimonialSection
    scheme={2}
    eyebrow="Real Stories"
    heading="Rescue coordinators love Barkhaus"
    testimonials={[
      {
        quote: 'Barkhaus cut our administrative work in half. Our applications and social posts finally live in one place.',
        name: 'Sarah Martinez',
        role: 'Executive Director, Paws Hope Rescue',
        imageSrc: '/images/home-testimonial-section-0.jpg',
      },
      {
        quote: "Our public site updates the moment we add an animal. No more asking a volunteer to edit the website by hand.",
        name: 'Michael Chen',
        role: 'Operations Manager, Urban Animal Shelter',
        imageSrc: '/images/home-testimonial-section-1.jpg',
      },
      {
        quote: 'We increased adoption rates by 40% since switching to Barkhaus. The social media tools are a game changer.',
        name: 'Elena Rodriguez',
        role: 'Founder, Rescue Friends Network',
        imageSrc: '/images/home-testimonial-section-2.jpg',
      },
    ]}
  />

  <!-- CTA: Start free account -->
  <CTABanner
    headline="Start your free account"
    primaryCta={{ label: "Get Started — It's Free", href: '/signup' }}
  />

  <!-- Newsletter -->
  <NewsletterSection />

  <!-- Contact CTA -->
  <ContactSection scheme={2} />

  <Footer />
</BaseLayout>
