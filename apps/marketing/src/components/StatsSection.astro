---
export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  scheme?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
  eyebrow?: string;
  heading: string;
  stats: Stat[];
  imageSrc: string;
  imageAlt?: string;
  reverse?: boolean;
}

const { scheme = 1, eyebrow, heading, stats, imageSrc, imageAlt = '', reverse = false } = Astro.props;
---

<section class={`scheme-${scheme} py-20`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class={reverse ? 'lg:order-2' : ''}>
        <img src={imageSrc} alt={imageAlt} class="rounded-card shadow-xl w-full object-cover" loading="lazy" />
      </div>
      <div class={reverse ? 'lg:order-1' : ''}>
        {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider scheme-accent mb-3">{eyebrow}</p>}
        <h2 class="font-serif text-3xl font-medium mb-8">{heading}</h2>
        <div class="grid grid-cols-3 gap-6">
          {stats.map(({ value, label }) => (
            <div>
              <div class="font-serif text-3xl sm:text-4xl font-medium text-warm-brown mb-1">{value}</div>
              <div class="text-sm opacity-80 leading-snug">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
