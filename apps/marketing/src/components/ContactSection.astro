---
export interface Props {
  scheme?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
  heading?: string;
  subtext?: string;
}

const {
  scheme = 2,
  heading = 'Questions before you get started?',
  subtext = "We're happy to walk you through the platform or talk through your rescue's specific needs.",
} = Astro.props;
---

<section class={`scheme-${scheme} py-20`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <div class="bg-white rounded-card border scheme-border p-10 shadow-sm">
      <h2 class="font-serif text-2xl sm:text-3xl font-medium text-deep-taupe mb-3">{heading}</h2>
      <p class="text-deep-taupe/80 mb-8 max-w-xl mx-auto">{subtext}</p>
      <a href="/contact" class="inline-block px-7 py-3 bg-warm-brown text-white rounded-button text-sm font-semibold hover:opacity-90 transition">
        Talk to us
      </a>
    </div>
  </div>
</section>
