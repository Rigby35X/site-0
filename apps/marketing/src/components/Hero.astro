---
export interface Tab {
  id: string;
  eyebrow: string;
  headline: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
}

export interface Props {
  headline?: string;
  subheadline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  imageSrc?: string;
  imageAlt?: string;
  tabs?: Tab[];
}

const {
  headline,
  subheadline,
  primaryCta = { label: 'Get started', href: '/signup' },
  secondaryCta = { label: 'Learn more', href: '#features' },
  imageSrc,
  imageAlt = '',
  tabs,
} = Astro.props;
---

{tabs ? (
  <!-- Animated-tabs hero -->
  <section class="scheme-7 pt-32 pb-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Tab selector -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" role="tablist">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class="hero-tab-btn px-4 py-2 text-sm font-semibold rounded-button border transition-colors data-[active=true]:bg-deep-taupe data-[active=true]:text-white data-[active=true]:border-deep-taupe border-dove text-deep-taupe hover:border-warm-brown"
            data-tab-target={tab.id}
            data-active={i === 0 ? 'true' : 'false'}
            role="tab"
          >
            {tab.eyebrow}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div class="relative">
        {tabs.map((tab, i) => (
          <div class="hero-tab-panel" data-tab-panel={tab.id} data-active={i === 0 ? 'true' : 'false'}>
            <div class="grid lg:grid-cols-2 gap-12 items-center">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-warm-brown mb-3">{tab.eyebrow}</p>
                <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] leading-[1.1] font-medium text-deep-taupe mb-6">
                  {tab.headline}
                </h1>
                <p class="text-lg text-deep-taupe/80 leading-relaxed mb-8 max-w-xl">
                  {tab.description}
                </p>
                <div class="flex flex-wrap gap-4">
                  <a href="/signup" class="px-7 py-3 text-base font-semibold bg-warm-brown text-white rounded-button hover:opacity-90 transition shadow-lg">
                    Get Started
                  </a>
                  <a href="/features" class="px-7 py-3 text-base font-semibold border border-dove text-deep-taupe rounded-button hover:bg-cararra-3 transition">
                    See Demo
                  </a>
                </div>
              </div>
              <div class="relative">
                <div class="absolute inset-0 bg-warm-brown/10 rounded-card transform rotate-2"></div>
                <img
                  src={tab.imageSrc}
                  alt={tab.imageAlt}
                  class="relative rounded-card shadow-2xl w-full object-cover aspect-[4/3]"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.hero-tab-btn');
    const panels = document.querySelectorAll<HTMLDivElement>('.hero-tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabTarget;
        buttons.forEach((b) => (b.dataset.active = String(b === btn)));
        panels.forEach((p) => (p.dataset.active = String(p.dataset.tabPanel === target)));
      });
    });
  </script>

  <style>
    .hero-tab-panel {
      display: none;
    }
    .hero-tab-panel[data-active='true'] {
      display: block;
      animation: tab-fade-in 0.4s ease;
    }
    @keyframes tab-fade-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
) : (
  <!-- Simple hero (legacy pages) -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-cloud via-white to-dove overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class={`grid gap-12 items-center ${imageSrc ? 'lg:grid-cols-2' : ''}`}>

        <div class={imageSrc ? '' : 'max-w-3xl mx-auto text-center'}>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-deep-taupe leading-tight mb-6">
            {headline}
          </h1>
          <p class="text-lg sm:text-xl text-deep-taupe leading-relaxed mb-8 max-w-2xl">
            {subheadline}
          </p>
          <div class="flex flex-wrap gap-4 justify-start">
            <a href={primaryCta.href} class="px-7 py-3 text-base font-semibold bg-warm-brown text-white rounded-xl hover:opacity-90 transition shadow-lg">
              {primaryCta.label}
            </a>
            <a href={secondaryCta.href} class="px-7 py-3 text-base font-semibold border-2 border-stone text-deep-taupe rounded-xl hover:bg-cloud transition">
              {secondaryCta.label}
            </a>
          </div>
        </div>

        {imageSrc && (
          <div class="relative">
            <div class="absolute inset-0 bg-warm-brown/10 rounded-3xl transform rotate-3"></div>
            <img
              src={imageSrc}
              alt={imageAlt}
              class="relative rounded-3xl shadow-2xl w-full object-cover"
              loading="eager"
            />
          </div>
        )}
      </div>
    </div>
  </section>
)}
