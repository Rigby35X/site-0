---
export interface Benefit {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  scheme?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
  eyebrow?: string;
  heading: string;
  benefits: Benefit[];
}

const { scheme = 8, eyebrow, heading, benefits } = Astro.props;
---

<section class={`scheme-${scheme} py-20`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider scheme-accent mb-3">{eyebrow}</p>}
      <h2 class="font-serif text-3xl sm:text-4xl font-medium">{heading}</h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-8">
      {benefits.map(({ icon, title, description }) => (
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center text-3xl mx-auto mb-5">
            {icon}
          </div>
          <h3 class="font-serif text-xl font-medium mb-2">{title}</h3>
          <p class="text-sm opacity-80 leading-relaxed max-w-xs mx-auto">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
