---
export interface Testimonial {
  quote: string;
  name: string;
  role: string;
  imageSrc?: string;
}

export interface Props {
  scheme?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
  eyebrow?: string;
  heading: string;
  testimonials: Testimonial[];
}

const { scheme = 2, eyebrow, heading, testimonials } = Astro.props;
---

<section class={`scheme-${scheme} py-20`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider scheme-accent mb-3">{eyebrow}</p>}
      <h2 class="font-serif text-3xl sm:text-4xl font-medium">{heading}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map(({ quote, name, role, imageSrc }) => (
        <div class="bg-white rounded-card border scheme-border p-8 flex flex-col gap-6 shadow-sm">
          <svg class="w-8 h-8 text-vanilla flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-base text-deep-taupe leading-relaxed flex-1 italic">"{quote}"</p>
          <div class="flex items-center gap-3">
            {imageSrc ? (
              <img src={imageSrc} alt={name} class="w-10 h-10 rounded-full object-cover" loading="lazy" />
            ) : (
              <div class="w-10 h-10 rounded-full bg-vanilla-1 flex items-center justify-center text-warm-brown font-bold text-sm">
                {name[0]}
              </div>
            )}
            <div>
              <p class="text-sm font-semibold text-deep-taupe">{name}</p>
              <p class="text-xs text-deep-taupe/70">{role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
